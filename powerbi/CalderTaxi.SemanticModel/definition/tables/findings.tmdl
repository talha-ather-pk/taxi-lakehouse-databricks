table findings
	lineageTag: 4b5667ca-eb01-5d41-a941-6f8a4fe8b816

	column key
		dataType: string
		lineageTag: 5e7251e5-4768-50a9-9853-a64a5e13d22f
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = User

	column value
		dataType: double
		isHidden
		lineageTag: dd8a7c39-7d35-539a-8fc5-7375cea35aee
		summarizeBy: none
		sourceColumn: value

		annotation SummarizationSetBy = User

	column finding
		dataType: string
		lineageTag: 76901a76-9517-5aae-a03c-7f58d2bb6d0c
		summarizeBy: none
		sourceColumn: finding

		annotation SummarizationSetBy = User

	partition findings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "findings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "value", "finding"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"key", type text}, {"value", type number}, {"finding", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
