		annotation SummarizationSetBy = User

	column do_borough
		dataType: string
		lineageTag: e126e395-72dc-5ccc-88ae-32d1869290f9
		summarizeBy: none
		sourceColumn: do_borough

		annotation SummarizationSetBy = User

	column trips
		dataType: int64
