	partition fact_flows = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "borough_flows.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"pickup_month", "pu_borough", "do_borough", "trips", "revenue", "fare_revenue"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"pickup_month", type text}, {"pu_borough", type text}, {"do_borough", type text}, {"trips", Int64.Type}, {"revenue", type number}, {"fare_revenue", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
