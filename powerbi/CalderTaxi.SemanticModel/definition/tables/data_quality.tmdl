table data_quality
	lineageTag: 03ba9cdc-4199-5958-a329-25c1f0a3e0ee

	column step
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0ae132ca-9035-5b6f-a170-21bda07965ea
		summarizeBy: none
		sourceColumn: step

		annotation SummarizationSetBy = User

	column layer
		dataType: string
		lineageTag: 746aaa57-26cb-515b-ba31-278e6d329b80
		summarizeBy: none
		sourceColumn: layer

		annotation SummarizationSetBy = User

	column metric
		dataType: string
		sortByColumn: step
		lineageTag: b2093667-f176-5474-a2a3-32651285b345
		summarizeBy: none
		sourceColumn: metric

		annotation SummarizationSetBy = User

	column rows
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 569a0510-59df-56f4-8993-500a41ce4d4a
		summarizeBy: none
		sourceColumn: rows

		annotation SummarizationSetBy = User

	column injected
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 559e306f-ba01-572b-9373-8413aefdfe4b
		summarizeBy: none
		sourceColumn: injected

		annotation SummarizationSetBy = User

	partition data_quality = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "data_quality.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"step", "layer", "metric", "rows", "injected"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"step", Int64.Type}, {"layer", type text}, {"metric", type text}, {"rows", Int64.Type}, {"injected", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
