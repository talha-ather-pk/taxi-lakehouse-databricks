table dim_borough
	lineageTag: d1c2aa40-4cb3-5e0d-8b77-fb5d6b9f219e

	column borough
		dataType: string
		isKey
		lineageTag: 766bcca8-d88f-50c6-8eab-3acdac494141
		summarizeBy: none
		sourceColumn: borough

		annotation SummarizationSetBy = User

	partition dim_borough = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "silver_zones.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"borough"}),
				    Distinct = Table.Distinct(Kept),
				    Typed = Table.TransformColumnTypes(Distinct, {{"borough", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
