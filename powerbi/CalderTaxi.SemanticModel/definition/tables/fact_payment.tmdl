table fact_payment
	lineageTag: bc030963-0947-5015-9c1e-69a1ee850675

	column pickup_month
		dataType: string
		isHidden
		lineageTag: 295cd236-0c4b-5d67-9531-ad092c6425d0
		summarizeBy: none
		sourceColumn: pickup_month

		annotation SummarizationSetBy = User

	column payment_type
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 99cda466-bc12-5853-aac9-992b767b59c7
		summarizeBy: none
		sourceColumn: payment_type

		annotation SummarizationSetBy = User

	column payment_desc
		dataType: string
		sortByColumn: payment_type
		lineageTag: cbf300e0-c777-5855-9dd4-1b1beaad14f9
		summarizeBy: none
		sourceColumn: payment_desc

		annotation SummarizationSetBy = User

	column trips
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 812039b6-492d-5da2-aa76-1497625080d4
		summarizeBy: none
		sourceColumn: trips

		annotation SummarizationSetBy = User

	column revenue
		dataType: double
		isHidden
		lineageTag: 2016c25b-9480-575e-803b-05229221082f
		summarizeBy: none
		sourceColumn: revenue

		annotation SummarizationSetBy = User

	column fare_revenue
		dataType: double
		isHidden
		lineageTag: 108d098c-da5d-5ea7-8673-7ded3b3358c3
		summarizeBy: none
		sourceColumn: fare_revenue

		annotation SummarizationSetBy = User

	column tips
		dataType: double
		isHidden
