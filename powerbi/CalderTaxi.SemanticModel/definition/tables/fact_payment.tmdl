		sourceColumn: tips

		annotation SummarizationSetBy = User

	partition fact_payment = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "payment_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"pickup_month", "payment_type", "payment_desc", "trips", "revenue", "fare_revenue", "tips"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"pickup_month", type text}, {"payment_type", Int64.Type}, {"payment_desc", type text}, {"trips", Int64.Type}, {"revenue", type number}, {"fare_revenue", type number}, {"tips", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
