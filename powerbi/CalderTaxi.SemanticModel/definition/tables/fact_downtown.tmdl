table fact_downtown
	lineageTag: f52492a2-991d-5eb4-b709-275dd1ab6602

	column date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: cf3eecf8-6f4d-56d8-aebb-cd4a7fc10b67
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = User

	column segment
		dataType: string
		lineageTag: bfcea734-4310-5af4-9d05-938b12239420
		summarizeBy: none
		sourceColumn: segment

		annotation SummarizationSetBy = User

	column trips
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1dccfb46-b245-5d0b-b33d-6d944a433b53
		summarizeBy: none
		sourceColumn: trips

		annotation SummarizationSetBy = User

	column revenue
		dataType: double
		isHidden
		lineageTag: 5388bd0f-c6b3-5ce0-9430-0b976e71f689
		summarizeBy: none
		sourceColumn: revenue

		annotation SummarizationSetBy = User

	column cbd_fees
		dataType: double
		isHidden
		lineageTag: def538be-a7ee-5caa-bc93-71b138f94c7e
		summarizeBy: none
		sourceColumn: cbd_fees

		annotation SummarizationSetBy = User

	partition fact_downtown = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "downtown_daily.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"date", "segment", "trips", "revenue", "cbd_fees"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"segment", type text}, {"trips", Int64.Type}, {"revenue", type number}, {"cbd_fees", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
