	partition fact_zone_daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "zone_daily.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"date", "location_id", "trips", "revenue", "fare_revenue", "tips", "distance_mi", "duration_min", "card_trips", "card_fares", "card_tips"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"location_id", Int64.Type}, {"trips", Int64.Type}, {"revenue", type number}, {"fare_revenue", type number}, {"tips", type number}, {"distance_mi", type number}, {"duration_min", type number}, {"card_trips", Int64.Type}, {"card_fares", type number}, {"card_tips", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
