	partition pipeline_batches = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pipeline_batches.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"batch_id", "files", "rows_in", "exact_duplicates", "rejected", "same_key_duplicates", "inserted", "updated", "silver_version", "months_touched", "schema_notes"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"batch_id", type text}, {"files", type text}, {"rows_in", Int64.Type}, {"exact_duplicates", Int64.Type}, {"rejected", Int64.Type}, {"same_key_duplicates", Int64.Type}, {"inserted", Int64.Type}, {"updated", Int64.Type}, {"silver_version", Int64.Type}, {"months_touched", type text}, {"schema_notes", type text}}, "en-US"),
				    Sorted = Table.Sort(Typed, {"batch_id", Order.Ascending}),
				    Idx = Table.AddIndexColumn(Sorted, "run_order", 1, 1, Int64.Type),
				    Run = Table.AddColumn(Idx, "run", each if [run_order] = 1 then "1 · Initial load" else Text.From([run_order]) & " · Incremental load", type text)
				in
				    Run

	annotation PBI_ResultType = Table
