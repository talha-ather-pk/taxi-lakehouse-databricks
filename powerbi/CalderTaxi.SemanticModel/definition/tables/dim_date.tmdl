table dim_date
	dataCategory: Time
	lineageTag: 54f1cddb-da5f-5233-a418-ed1bf6d7e267

	column date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: befedce6-d216-5a46-9a38-85e8743bd15e
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = User

	column precip_mm
		dataType: double
		isHidden
		lineageTag: ddc2fc5d-542a-5f2e-af76-0974859932e5
		summarizeBy: none
		sourceColumn: precip_mm

		annotation SummarizationSetBy = User

	column temp_c
		dataType: double
		isHidden
		lineageTag: ca44fcab-cc7e-50c0-b6c6-8302aa148de5
		summarizeBy: none
		sourceColumn: temp_c

		annotation SummarizationSetBy = User

	column is_rainy
		dataType: string
		isHidden
		lineageTag: bd755e1b-81a0-55a9-8919-0cd77d73d40d
		summarizeBy: none
		sourceColumn: is_rainy

		annotation SummarizationSetBy = User

	column weather
		dataType: string
		lineageTag: eaa32991-ce29-5c67-950f-c87e857f7826
		summarizeBy: none
		sourceColumn: weather

		annotation SummarizationSetBy = User

	column holiday
		dataType: string
		lineageTag: ec4124ad-37c3-5883-9e6d-c761bdcdfd6d
		summarizeBy: none
		sourceColumn: holiday

		annotation SummarizationSetBy = User

	column pickup_month
		dataType: string
		isHidden
		lineageTag: da2c3447-b880-523c-8602-4e0c7c16ebb7
		summarizeBy: none
		sourceColumn: pickup_month

		annotation SummarizationSetBy = User

	column week_start
		dataType: dateTime
		formatString: dd mmm
		lineageTag: 2d6ccb71-17d7-5413-84e6-67c384c97b0a
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = User

	column weekday_num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0e55aef9-3467-5727-a52d-d53eed16b87f
		summarizeBy: none
		sourceColumn: weekday_num

		annotation SummarizationSetBy = User

	column weekday
		dataType: string
		sortByColumn: weekday_num
		lineageTag: 6f18863d-0a3f-5f22-87a7-c43bbed4b15c
		summarizeBy: none
		sourceColumn: weekday

		annotation SummarizationSetBy = User

	column day_type
		dataType: string
		isHidden
		lineageTag: 94d25991-b0db-542d-a740-ccea9fa4b223
		summarizeBy: none
		sourceColumn: day_type

		annotation SummarizationSetBy = User

	column fee_period
		dataType: string
		lineageTag: fb4d0e85-2452-5ba4-b277-4b66f1c385a2
		summarizeBy: none
		sourceColumn: fee_period

		annotation SummarizationSetBy = User

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "silver_weather.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"date", "precip_mm", "temp_c", "is_rainy"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"precip_mm", type number}, {"temp_c", type number}, {"is_rainy", type text}}, "en-US"),
				    Weather = Table.AddColumn(Typed, "weather", each if [is_rainy] = "True" then "Rain (2 mm+)" else "Dry", type text),
				    Holiday = Table.AddColumn(Weather, "holiday", each Record.FieldOrDefault([#"2025-01-01" = "New Year's Day", #"2025-01-20" = "Martin Luther King Jr. Day", #"2025-02-17" = "Presidents' Day", #"2025-05-26" = "Memorial Day"], Date.ToText([date], "yyyy-MM-dd"), null), type text),
				    Month = Table.AddColumn(Holiday, "pickup_month", each Date.ToText([date], "yyyy-MM"), type text),
				    WeekStart = Table.AddColumn(Month, "week_start", each Date.StartOfWeek([date], Day.Monday), type date),
				    WdNum = Table.AddColumn(WeekStart, "weekday_num", each Date.DayOfWeek([date], Day.Monday) + 1, Int64.Type),
				    Wd = Table.AddColumn(WdNum, "weekday", each Date.ToText([date], "ddd", "en-US"), type text),
				    DayType = Table.AddColumn(Wd, "day_type", each if [weekday_num] >= 6 then "Weekend" else "Weekday", type text),
				    Fee = Table.AddColumn(DayType, "fee_period", each if [date] >= #date(2025, 3, 1) then "After fee (Mar–Jun)" else "Before fee (Jan–Feb)", type text)
				in
				    Fee

	annotation PBI_ResultType = Table
